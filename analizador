<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analizador de Ruido - Sistema de Sonido La Onda</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #1a1a1a;
            color: #f0f0f0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
            text-align: center;
        }
        .container {
            background-color: #2a2a2a;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.5);
            max-width: 500px;
            width: 100%;
        }
        h1 { color: #00d2ff; margin-bottom: 5px; font-size: 1.5rem; }
        h2 { color: #888; font-size: 1rem; margin-bottom: 30px; font-weight: normal; }
        
        #status-display {
            font-size: 2rem;
            font-weight: bold;
            padding: 20px;
            border-radius: 8px;
            margin: 20px 0;
            background-color: #333;
            transition: all 0.3s ease;
        }
        
        .db-readout {
            font-family: monospace;
            font-size: 3rem;
            margin: 10px 0;
        }

        button {
            background-color: #00d2ff;
            color: #1a1a1a;
            border: none;
            padding: 15px 30px;
            font-size: 1.1rem;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.2s;
            margin-top: 20px;
        }
        button:hover { background-color: #00a8cc; }
        button:disabled { background-color: #555; cursor: not-allowed; }

        /* Barra visual de nivel */
        .meter-container {
            width: 100%;
            height: 30px;
            background-color: #111;
            border-radius: 15px;
            overflow: hidden;
            margin-top: 20px;
            position: relative;
        }
        .meter-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #4caf50 0%, #ffeb3b 70%, #f44336 100%);
            transition: width 0.1s ease-out;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>Sistema de Sonido La Onda</h1>
        <h2>Analizador de Ruido Ambiental</h2>

        <div id="status-display">Esperando...</div>
        <div class="db-readout"><span id="db-value">-∞</span> dBFS</div>
        
        <div class="meter-container">
            <div class="meter-fill" id="meter"></div>
        </div>

        <button id="start-btn">Iniciar Medición</button>
    </div>

    <script>
        let audioContext;
        let analyser;
        let microphone;
        let animationId;

        const startBtn = document.getElementById('start-btn');
        const statusDisplay = document.getElementById('status-display');
        const dbValueDisplay = document.getElementById('db-value');
        const meterFill = document.getElementById('meter');

        startBtn.addEventListener('click', async () => {
            try {
                // Solicitar acceso al micrófono (Requiere HTTPS)
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
                
                // Inicializar contexto de audio
                audioContext = new (window.AudioContext || window.webkitAudioContext)();
                analyser = audioContext.createAnalyser();
                analyser.fftSize = 1024; // Tamaño de la ventana FFT
                
                microphone = audioContext.createMediaStreamSource(stream);
                microphone.connect(analyser);
                
                startBtn.disabled = true;
                startBtn.innerText = "Midiendo...";
                
                analyzeAudio();
            } catch (err) {
                console.error('Error al acceder al micrófono:', err);
                statusDisplay.innerText = "Error: Permiso denegado";
                statusDisplay.style.color = "#f44336";
                alert("Debes permitir el acceso al micrófono para usar el analizador.");
            }
        });

        function analyzeAudio() {
            const bufferLength = analyser.frequencyBinCount;
            const dataArray = new Float32Array(bufferLength);
            
            const updateMeter = () => {
                analyser.getFloatTimeDomainData(dataArray);
                
                // Calcular RMS (Root Mean Square)
                let sumSquares = 0.0;
                for (let i = 0; i < bufferLength; i++) {
                    sumSquares += dataArray[i] * dataArray[i];
                }
                const rms = Math.sqrt(sumSquares / bufferLength);
                
                // Convertir RMS a dBFS (Decibelios relativos a Full Scale)
                // 0 dBFS es el máximo digital, por lo que los valores serán negativos
                let db = 20 * Math.log10(rms);
                
                // Evitar -Infinity cuando hay silencio absoluto
                if (!isFinite(db) || db < -100) db = -100;
                
                // Actualizar interfaz
                dbValueDisplay.innerText = db.toFixed(1);
                
                // Convertir dB a un porcentaje para la barra (rango aprox de -80 a 0)
                let percent = ((db + 80) / 80) * 100;
                if (percent < 0) percent = 0;
                if (percent > 100) percent = 100;
                meterFill.style.width = percent + '%';

                // Lógica de Clasificación Acústica
                if (db < -50) {
                    statusDisplay.innerText = "Silencioso";
                    statusDisplay.style.backgroundColor = "rgba(76, 175, 80, 0.2)";
                    statusDisplay.style.color = "#4caf50";
                } else if (db >= -50 && db < -30) {
                    statusDisplay.innerText = "Aceptable para grabación";
                    statusDisplay.style.backgroundColor = "rgba(255, 235, 59, 0.2)";
                    statusDisplay.style.color = "#ffeb3b";
                } else {
                    statusDisplay.innerText = "Con ruido excesivo";
                    statusDisplay.style.backgroundColor = "rgba(244, 67, 54, 0.2)";
                    statusDisplay.style.color = "#f44336";
                }

                animationId = requestAnimationFrame(updateMeter);
            };
            
            updateMeter();
        }
    </script>
</body>
</html>
